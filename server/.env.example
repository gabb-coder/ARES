# ─── ARES server configuration ─────────────────────────────────────────────
# Copy to server/.env and adjust. Every value is optional.

# Network. Keep 127.0.0.1 unless you know you want ARES reachable on your LAN.
ARES_HOST=127.0.0.1
ARES_PORT=3001
# Comma-separated extra origins allowed to call the API.
ARES_ALLOWED_ORIGINS=

# Filesystem hooks are confined to this directory. Default: your home folder.
ARES_FS_ROOT=~
# Drop-in hook plugins (relative to server/).
ARES_PLUGIN_DIR=plugins
# Log system actions (open URL, launch app, open file) instead of doing them.
ARES_DRY_RUN=false
# ARES's own state: reminders and integration sign-ins.
ARES_DATA_DIR=~/.ares

# On macOS ARES can open, quit and switch to any installed app by name.
# Elsewhere (or for nicknames) list apps as {"spoken name": ["command", "arg", ...]}.
# Spawned directly, never through a shell. Leave empty for per-OS defaults.
# ARES_APPS={"spotify":["spotify"],"browser":["firefox"]}

# ─── Weather (Open-Meteo, free, no key) ────────────────────────────────────
# Default place for "what's the weather?": a city, or "lat,lon".
WEATHER_LOCATION=
# celsius or fahrenheit (default follows your system's region).
WEATHER_UNITS=

# ─── Text-to-speech ────────────────────────────────────────────────────────
# browser    = Web Speech Synthesis in the dashboard. Free, offline, no keys.
# elevenlabs = ElevenLabs API (needs ELEVENLABS_API_KEY)
# fishaudio  = Fish Audio API (needs FISH_AUDIO_API_KEY)
# Cloud providers fall back to the browser voice if a request fails.
TTS_PROVIDER=browser

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 trades a little quality for much lower latency.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

FISH_AUDIO_API_KEY=
# Voice model id from fish.audio (blank = provider default voice).
FISH_AUDIO_REFERENCE_ID=
# Optional "model" header, e.g. s2.1-pro or s1 (blank = provider default).
FISH_AUDIO_MODEL=

# ─── Local speech-to-text (optional) ───────────────────────────────────────
# By default the dashboard uses the browser's Web Speech API. To transcribe
# locally instead (and in browsers without Web Speech, like Firefox), run a
# whisper server and point ARES at it:
#   whisper.cpp:  ./build/bin/whisper-server -m models/ggml-base.en.bin --port 8080
LOCAL_STT_URL=
# whisper.cpp  -> POST {url}/inference
# openai       -> POST {url}/v1/audio/transcriptions (faster-whisper-server, speaches, LocalAI)
LOCAL_STT_API=whisper.cpp
LOCAL_STT_MODEL=whisper-1
LOCAL_STT_LANGUAGE=en

# ─── AI model (optional; needed for integrations) ──────────────────────────
# Handles requests no built-in command matches: answers questions, and uses
# tools (your files, plus apps from integrations.json) to get things done.
# none      = reply "No hook handles that yet." Fully offline.
# ollama    = a local model through Ollama. Free and offline.
# anthropic = Claude through the Anthropic API (needs ANTHROPIC_API_KEY).
ARES_BRAIN=none
# Number of previous exchanges sent for context.
ARES_BRAIN_HISTORY=6
# Most tools offered to the model per request (small local models do best with fewer).
ARES_AGENT_MAX_TOOLS=40

OLLAMA_URL=http://127.0.0.1:11434
# Any Ollama model with tool support; qwen3:8b is a good default on a laptop.
OLLAMA_MODEL=qwen3:8b
# false = skip the model's "thinking" step for faster spoken replies.
OLLAMA_THINK=false
# Context window; tool definitions need room. On an 8 GB Mac use 8192.
OLLAMA_NUM_CTX=16384
# Seconds to wait for an answer before giving up.
OLLAMA_TIMEOUT=180

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ─── Integrations (optional) ───────────────────────────────────────────────
# Apps are configured in server/integrations.json (copy integrations.example.json).
# Secrets referenced there as ${NAME} are read from this file:
# ARES_INTEGRATIONS=integrations.json
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_TOKEN=
# NOTION_TOKEN=
# SLACK_MCP_XOXP_TOKEN=
