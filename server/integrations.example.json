{
  "mcpServers": {
    "google": {
      "command": "uvx",
      "args": ["workspace-mcp", "--tool-tier", "core", "--tools", "gmail", "calendar", "drive", "docs"],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      },
      "keywords": ["email", "emails", "gmail", "inbox", "mail", "calendar", "meeting", "event", "schedule", "drive", "doc", "docs", "google"],
      "disabled": true
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ${GITHUB_TOKEN}" },
      "keywords": ["github", "repo", "repository", "issue", "pull request", "pr"],
      "disabled": true
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server@2.5.2"],
      "env": { "NOTION_TOKEN": "${NOTION_TOKEN}" },
      "keywords": ["notion", "page", "wiki", "notes"],
      "disabled": true
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "slack-mcp-server@1.3.0", "--transport", "stdio"],
      "env": { "SLACK_MCP_XOXP_TOKEN": "${SLACK_MCP_XOXP_TOKEN}" },
      "keywords": ["slack", "channel", "dm", "message", "messages", "thread"],
      "disabled": true
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "keywords": ["linear", "ticket", "issue", "bug", "project"],
      "disabled": true
    }
  }
}
